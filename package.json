{
  "name": "chuchotriz",
  "private": true,
  "version": "0.0.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:free && tsc && vite build && node scripts/check-free.mjs --dist",
    "preview": "vite preview",
    "watch": "tsc && vite build --watch",
    "test": "vitest run && node --test scripts/check-free.test.mjs scripts/options-market-reader.test.mjs scripts/options-position-reader.test.mjs scripts/options-executions-reader.test.mjs && node --test tools/qa/*.test.mjs",
    "check:free": "node scripts/check-free.mjs",
    "package:free": "npm run build && node scripts/package-free.mjs",
    "security:lint": "eslint \"src/**/*.{ts,tsx,js,jsx,mjs,cjs}\" \"public/**/*.{ts,tsx,js,jsx,mjs,cjs}\" --no-error-on-unmatched-pattern --max-warnings=0",
    "security:policy": "node scripts/security/check-policy.mjs",
    "security:test": "node --test scripts/security/*.test.mjs",
    "security:tools": "node scripts/security/run-tools.mjs",
    "security:check": "npm run security:test && npm run security:policy && npm run security:lint",
    "test:smoke": "npm run package:free && node tools/qa/run.mjs --smoke",
    "test:regression": "npm run package:free && node tools/qa/run.mjs",
    "test:pr": "npm run security:check && npm test && npm run package:free && npm audit --audit-level=moderate && node tools/qa/run.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "eslint": "10.14.0",
    "@typescript-eslint/parser": "8.72.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
