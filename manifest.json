{
  "name": "ChuchoTriz",
  "short_name": "ChuchoTriz",
  "description": "Presets de cantidad y simulador de estrategias de opciones con cadena de Matriz y gráficos de resultados.",
  "version": "0.0.23",
  "author": "Chucho Trader",
  "homepage_url": "https://x.com/chuchotrader",
  "manifest_version": 3,
  "options_page": "index.html",
  "options_ui": {
    "page": "index.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "logo16.png",
    "24": "logo24.png",
    "32": "logo32.png",
    "48": "logo48.png",
    "64": "logo64.png",
    "128": "logo128.png",
    "512": "logo512.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.xoms.com.ar/*", "https://remarkets.matriz.com.ar/*"],
      "js": ["src/main.tsx"],
      "media": [],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["options-market-reader.js", "options-position-reader.js", "options-executions-reader.js"],
    "matches": ["https://*.xoms.com.ar/*", "https://remarkets.matriz.com.ar/*"]
  }],
  "permissions": [
    "storage"
  ]
}
